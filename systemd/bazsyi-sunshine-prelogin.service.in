[Unit]
Description=Bazsyi Sunshine pre-login KMS host
Wants=network-online.target user@__UID__.service
After=network-online.target systemd-user-sessions.service plasmalogin.service user@__UID__.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
Group=__GROUP__
SupplementaryGroups=input video render
WorkingDirectory=__HOME__
Environment=HOME=__HOME__
Environment=USER=__USER__
Environment=LOGNAME=__USER__
Environment=XDG_CONFIG_HOME=__HOME__/.config
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/__UID__/bus
Environment=PULSE_SERVER=unix:/run/user/__UID__/pulse/native
UMask=0077
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_NICE
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do test -e __CARD_DEVICE__ && grep -qs "^connected$" /sys/class/drm/__CARD_NAME__-*/status && exit 0; sleep 1; done; exit 1'
ExecStartPre=/bin/sh -c '/usr/bin/systemctl --user start pipewire.service pipewire-pulse.service wireplumber.service || true'
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do /usr/bin/systemctl --user is-active --quiet pipewire.service pipewire-pulse.service wireplumber.service && /usr/bin/pactl list short sinks 2>/dev/null | /usr/bin/grep -q sink-sunshine-stereo && sleep 2 && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/sunshine __CONFIG__
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillSignal=SIGINT
SuccessExitStatus=0 130 143

[Install]
WantedBy=graphical.target
